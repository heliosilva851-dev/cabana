rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // POSTS
    // =========================
    match /posts/{postId} {

      // Ler
      allow read: if request.auth != null;

      // Criar
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      // Atualizar - APENAS O AUTOR
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;

      // Deletar - APENAS O AUTOR
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;

      // =========================
      // LIKES
      // =========================
      match /likes/{userId} {

        allow read: if request.auth != null;

        allow create, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      // =========================
      // COMMENTS
      // =========================
      match /comments/{commentId} {

        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.userId;

        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;

        // =========================
        // REPLIES
        // =========================
        match /replies/{replyId} {

          allow read: if request.auth != null;

          allow create: if request.auth != null
            && request.auth.uid == request.resource.data.userId;

          allow update, delete: if request.auth != null
            && request.auth.uid == resource.data.userId;
        }
      }
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if request.auth != null
        && request.auth.uid == userId;

      // =========================
      // FOLLOWERS
      // =========================
      match /followers/{followerId} {

        allow read: if request.auth != null;

        allow create, delete: if request.auth != null
          && request.auth.uid == followerId;
      }

      // =========================
      // FOLLOWING
      // =========================
      match /following/{followingId} {

        allow read: if request.auth != null;

        allow create, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      // =========================
      // COURSE_PROGRESS (NOVO)
      // =========================
      match /course_progress/{courseId} {

        // Ler: somente o próprio usuário
        allow read: if request.auth != null
          && request.auth.uid == userId;

        // Criar: somente o próprio usuário
        allow create: if request.auth != null
          && request.auth.uid == userId;

        // Atualizar: somente o próprio usuário
        allow update: if request.auth != null
          && request.auth.uid == userId;

        // Deletar: somente o próprio usuário
        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // =========================
    // CHATS
    // =========================
    match /chats/{chatId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null;

      // APENAS PARTICIPANTES PODEM EDITAR/DELETAR
      allow update, delete: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      // =========================
      // MESSAGES
      // =========================
      match /messages/{messageId} {

        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId;

        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.senderId;
      }
    }

    // =========================
    // NOTIFICATIONS
    // =========================
    match /notifications/{userId} {

      allow read: if request.auth != null
        && request.auth.uid == userId;

      match /items/{id} {

        allow read: if request.auth != null
          && request.auth.uid == userId;

        // CLOUD FUNCTION PODE CRIAR
        allow create: if true;

        allow update: if request.auth != null
          && request.auth.uid == userId;

        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // =========================
    // JOBS
    // =========================
    match /jobs/{jobId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null;

      // APENAS O CRIADOR PODE EDITAR/DELETAR
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    // =========================
    // COURSES
    // =========================
    match /courses/{courseId} {

      // leitura
      allow read: if request.auth != null;

      // criar
      allow create: if request.auth != null;

      // atualizar - VERIFICAR AMBOS OS NOMES (autorId e authorId)
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.autorId
          || request.auth.uid == resource.data.authorId);

      // deletar - VERIFICAR AMBOS OS NOMES
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.autorId
          || request.auth.uid == resource.data.authorId);

      // =========================
      // MODULES
      // =========================
      match /modules/{moduleId} {

        // leitura
        allow read: if request.auth != null;

        // criar
        allow create: if request.auth != null;

        // atualizar - VERIFICAR AMBOS OS NOMES
        allow update: if request.auth != null
          && (request.auth.uid ==
                get(
                  /databases/$(database)/documents/courses/$(courseId)
                ).data.autorId
            || request.auth.uid ==
                get(
                  /databases/$(database)/documents/courses/$(courseId)
                ).data.authorId);

        // deletar - VERIFICAR AMBOS OS NOMES
        allow delete: if request.auth != null
          && (request.auth.uid ==
                get(
                  /databases/$(database)/documents/courses/$(courseId)
                ).data.autorId
            || request.auth.uid ==
                get(
                  /databases/$(database)/documents/courses/$(courseId)
                ).data.authorId);

        // =========================
        // LESSONS
        // =========================
        match /lessons/{lessonId} {

          // leitura
          allow read: if request.auth != null;

          // criar
          allow create: if request.auth != null;

          // atualizar - VERIFICAR AMBOS OS NOMES
          allow update: if request.auth != null
            && (request.auth.uid ==
                  get(
                    /databases/$(database)/documents/courses/$(courseId)
                  ).data.autorId
              || request.auth.uid ==
                  get(
                    /databases/$(database)/documents/courses/$(courseId)
                  ).data.authorId);

          // deletar - VERIFICAR AMBOS OS NOMES
          allow delete: if request.auth != null
            && (request.auth.uid ==
                  get(
                    /databases/$(database)/documents/courses/$(courseId)
                  ).data.autorId
              || request.auth.uid ==
                  get(
                    /databases/$(database)/documents/courses/$(courseId)
                  ).data.authorId);
        }
      }
    }

    // =========================
    // COLLECTION GROUP COMMENTS
    // =========================
    match /{path=**}/comments/{commentId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // =========================
    // COLLECTION GROUP REPLIES
    // =========================
    match /{path=**}/replies/{replyId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // =========================
    // ENROLLMENTS
    // =========================
    match /enrollments/{enrollmentId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // =========================
    // REVIEWERS
    // =========================
    match /reviewers/{reviewerId} {

      // leitura liberada
      allow read: if true;

      // escrita bloqueada
      allow write: if false;
    }
  }
}
